# Dependencies and build output
node_modules/
dist/
.astro/

# Firebase CLI deploy cache, and the emulators' own copy of firebase.json
# (scripts/emulator/local-config.mjs writes it)
.firebase/
firebase.local.json

# Claude Code's local folder (worktrees, settings)
.claude/

# Secrets: service account keys and environment files must never be committed.
# The last two match the names the Google Cloud console gives downloaded keys
# (project id plus a 12 character key id) and the usual hand-picked names.
*firebase-adminsdk*.json
serviceAccountKey.json
*-service-account*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
key.json
*credentials*.json
.env
.env.*

# Editors, logs and OS files
.DS_Store
.idea/
*.iml
*.log

# Left over on disk from the old Flutter app (not part of the site)
/build/
.dart_tool/
.flutter-plugins-dependencies
