---
// The home page, assembled. `ground` picks hero version A or B.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import WhatWeBuild from './WhatWeBuild.astro';

interface Props {
  ground: 'A' | 'B';
  noindex?: boolean;
}
const { ground, noindex = false } = Astro.props;
---

<Base noindex={noindex}>
  <Header slot="header" />
  <Hero ground={ground} />
  <WhatWeBuild />
</Base>
