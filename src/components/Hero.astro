---
// Hero: the words on Chalk, then the demo on a Lime field that bleeds off the right
// and bottom edges (full width on a phone).
import home from '../copy/home.json';
import settings from '../settings.json';
import Demo from './Demo.astro';

const copy = home.hero;
const mailto = `mailto:${settings.contactEmail}?subject=${encodeURIComponent(settings.contactSubject)}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid page-grid">
    <h1 id="hero-title" class="title">
      {copy.headline.map((line, i) => <Fragment>{i > 0 && ' '}<span class="line">{line}</span></Fragment>)}
    </h1>

    <div class="intro">
      <p class="lede">{copy.supporting}</p>
      <div class="actions">
        <a class="btn btn--primary btn--large" href={mailto}>{copy.button}</a>
        <a class="text-link" href={copy.link.href}>{copy.link.label}</a>
      </div>
    </div>

    <div class="field">
      <Demo />
    </div>
  </div>
</section>

<style>
  .hero {
    /* The headline measures itself against the hero's width (cqi). */
    container: hero / inline-size;
    background: var(--chalk);
    padding-top: var(--s-5);
  }

  /* ---------- Words ---------- */
  /* Phones: 72 px over three lines. Tablet: 96 px over two. From 1200 px: one line. */
  .title {
    font-size: var(--fs-72);
    line-height: var(--lh-display);
  }
  .title .line {
    display: block;
  }
  .intro {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
    align-content: start;
  }
  .lede {
    max-width: 32ch;
    font-size: var(--fs-21);
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  /* ---------- Lime field ---------- */
  .field {
    container: field / inline-size;
    grid-column: full;
    margin-top: var(--s-6);
    padding: var(--s-4) var(--gutter);
    background: var(--lime);
  }

  @media (min-width: 48em) {
    .hero {
      padding-top: var(--s-6);
    }
    .title {
      font-size: var(--fs-96);
    }
    .field {
      grid-column: content-start / full-end;
      padding: var(--s-6) var(--s-7);
    }
  }

  /* From 1200 px: the headline on one line, words on the left and the demo to the right.
     Vertical space scales with the window height so the whole demo fits on the first screen
     of a short laptop. The headline is about 94 percent of the 1200 px container and never
     taller than 15 percent of the window. */
  @media (min-width: 75em) {
    .hero {
      --hero-space: clamp(0.75rem, 3vh, 2.5rem);
      padding-top: var(--hero-space);
    }
    .title {
      margin-bottom: var(--hero-space);
      font-size: min(calc(0.1025 * min(1200px, 100cqi - 2 * var(--gutter))), 15vh);
    }
    .title .line {
      display: inline;
    }
    .intro {
      grid-column: 2 / span 4;
      grid-row: 2;
      margin-top: 0;
      padding-top: var(--s-2);
    }
    .field {
      --field-space: clamp(1rem, 3.5vh, 2.5rem);
      grid-column: 6 / full-end;
      grid-row: 2;
      margin-top: 0;
      padding: var(--field-space) var(--s-7);
    }
  }
</style>
