---
// Hero: the words on Chalk, then the demo (a spreadsheet driving a phone's standings).
// ground "A": the demo sits on a Lime field that bleeds off the right and bottom edges.
// ground "B": the demo sits on Chalk; Lime appears only in the leader's row.
import home from '../copy/home.json';
import settings from '../settings.json';

interface Props {
  ground?: 'A' | 'B';
}
const { ground = 'A' } = Astro.props;
const copy = home.hero;
const a11y = copy.accessibility;
const mailto = `mailto:${settings.contactEmail}?subject=${encodeURIComponent(settings.contactSubject)}`;

const fill = (template: string, values: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key) => values[key] ?? '');
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const players = copy.players.map((p, index) => ({ ...p, id: slug(p.name), row: index + 2 }));
// Standings: highest points first; ties keep the sheet order (Array.sort is stable).
const standings = [...players].sort((a, b) => b.points - a.points);
---

<section class:list={['hero', `hero--${ground}`]} aria-labelledby="hero-title">
  <div class="hero-grid page-grid">
    <h1 id="hero-title" class="title">
      {copy.headline.map((line, i) => <Fragment>{i > 0 && ' '}<span class="line">{line}</span></Fragment>)}
    </h1>

    <div class="intro">
      <p class="lede">{copy.supporting}</p>
      <div class="actions">
        <a class="btn btn--primary btn--large" href={mailto}>{copy.button}</a>
        <a class="text-link" href={copy.link.href}>{copy.link.label}</a>
      </div>
    </div>

    <div
      class="demo-area"
      data-standings-demo
      data-moves-up={a11y.movesUp}
      data-moves-down={a11y.movesDown}
      data-places={JSON.stringify(a11y.places)}
    >
      <div class="demo">
        <div class="demo-sheet">
          <p class="label" id="sheet-label">{copy.sheetLabel}</p>
          <div class="sheet-scroll">
            <table class="sheet" aria-labelledby="sheet-label">
              <thead>
                <tr class="letters" aria-hidden="true">
                  <td class="corner"></td>
                  <td>A</td>
                  <td>B</td>
                </tr>
                <tr class="head">
                  <td class="num" aria-hidden="true">1</td>
                  <th scope="col">{copy.columns.player}</th>
                  <th scope="col">{copy.columns.points}</th>
                </tr>
              </thead>
              <tbody>
                {
                  players.map((p) => (
                    <tr data-player={p.id} data-name={p.name} data-points={p.points}>
                      <td class="num" aria-hidden="true">{p.row}</td>
                      <th scope="row">{p.name}</th>
                      <td class="points" data-cell>
                        <div class="points-inner">
                          <span class="value" data-value>{p.points}</span>
                          <span class="steps">
                            <button type="button" class="step" data-delta="-1" aria-label={fill(a11y.removePoint, { name: p.name })}>
                              <span aria-hidden="true">&#8722;</span>
                            </button>
                            <button type="button" class="step" data-delta="1" aria-label={fill(a11y.addPoint, { name: p.name })}>
                              <span aria-hidden="true">+</span>
                            </button>
                          </span>
                        </div>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div class="demo-phone">
          <p class="label" id="phone-label">{copy.phoneLabel}</p>
          <div class="phone" role="group" aria-labelledby="phone-label">
            <div class="screen">
              <span class="speaker" aria-hidden="true"></span>
              <p class="app-title" id="standings-title">{copy.screenTitle}</p>
              <ol class="standings" data-standings aria-labelledby="standings-title">
                {
                  standings.map((p, index) => (
                    <li class:list={['row', { 'is-leader': index === 0 }]} data-player={p.id}>
                      <span class="pos" data-pos>{index + 1}</span>
                      <span class="name">{p.name}</span>
                      <span class="pts">
                        <span data-points>{p.points}</span>
                        <span class="vh"> {a11y.pointsUnit}</span>
                      </span>
                    </li>
                  ))
                }
              </ol>
              <span class="home-bar" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>
      <p class="caption">{copy.caption}</p>
      <p class="vh" aria-live="polite" data-live></p>
    </div>
  </div>
</section>

<script>
  import '../scripts/standings.js';
</script>

<style>
  .hero {
    background: var(--chalk);
    padding-top: var(--s-6);
  }
  .hero--B {
    padding-bottom: var(--section-space);
  }

  /* ---------- Words ---------- */
  .title {
    font-size: var(--fs-hero-56);
    line-height: var(--lh-display);
  }
  .title .line {
    display: block;
  }
  .intro {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
    align-content: start;
  }
  .lede {
    max-width: 32ch;
    font-size: var(--fs-21);
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  /* ---------- Demo area ---------- */
  .demo-area {
    margin-top: var(--s-7);
  }
  .hero--A .demo-area {
    grid-column: full;
    background: var(--lime);
    padding: var(--s-6) var(--gutter) var(--s-7);
  }

  .demo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s-6) var(--s-7);
  }
  .demo-sheet {
    flex: 1 1 18rem;
    max-width: 25rem;
    min-width: 0;
  }
  .demo-phone {
    flex: 0 0 auto;
  }
  .label {
    margin-bottom: var(--s-3);
    font-size: var(--fs-16);
    font-weight: 600;
  }
  .caption {
    max-width: 44ch;
    margin-top: var(--s-6);
    font-size: var(--fs-16);
  }

  /* ---------- Spreadsheet ---------- */
  .sheet-scroll {
    overflow-x: auto;
  }
  .sheet {
    width: 100%;
    border-collapse: collapse;
    background: var(--chalk);
    font-size: var(--fs-16);
    line-height: 1.2;
  }
  .sheet th,
  .sheet td {
    height: 3.25rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--line);
    text-align: left;
    font-weight: 400;
    white-space: nowrap;
  }
  .sheet .letters td {
    height: 2rem;
    background: var(--cell);
  }
  .sheet .num,
  .sheet .corner {
    width: 2.5rem;
    background: var(--cell);
  }
  .sheet .head th {
    font-weight: 700;
  }
  .sheet .points {
    width: 1%;
    padding-inline-end: var(--s-1);
  }
  .points-inner {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .value {
    min-width: 2ch;
    text-align: right;
  }
  .steps {
    display: none;
    gap: var(--s-1);
  }
  :global(.js) .steps {
    display: inline-flex;
  }
  .sheet .points.is-active {
    outline: 2px solid var(--moss);
    outline-offset: -2px;
  }
  .step {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 2px solid var(--charcoal);
    border-radius: var(--radius-button);
    background: var(--chalk);
    color: var(--charcoal);
    font-size: var(--fs-24);
    line-height: 1;
    cursor: pointer;
  }
  .step:hover {
    background: var(--charcoal);
    color: var(--chalk);
  }
  .step[aria-disabled='true'] {
    border-color: var(--line);
    color: var(--line);
    background: var(--chalk);
    cursor: not-allowed;
  }

  /* ---------- Phone ---------- */
  .phone {
    width: 17.5rem;
    padding: 0.625rem;
    border-radius: var(--radius-phone);
    background: var(--charcoal);
  }
  .screen {
    display: flex;
    flex-direction: column;
    min-height: 25.5rem;
    padding: var(--s-3) var(--s-3) var(--s-3);
    border-radius: var(--radius-screen);
    background: var(--app-white);
  }
  .speaker,
  .home-bar {
    display: block;
    height: 0.375rem;
    margin-inline: auto;
    border-radius: 999px;
    background: var(--charcoal);
  }
  .speaker {
    width: 4.5rem;
    margin-bottom: var(--s-5);
  }
  .home-bar {
    width: 6rem;
    margin-top: auto;
  }
  .app-title {
    padding: 0 var(--s-2) var(--s-4);
    font-family: var(--font-display);
    font-size: var(--fs-48);
    line-height: var(--lh-display);
  }
  .standings {
    display: grid;
    gap: var(--s-1);
    padding: 0;
    margin-bottom: var(--s-5);
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-2);
    min-height: 3.25rem;
    padding: 0 var(--s-3);
    border-radius: var(--radius-button);
    background: var(--app-white);
  }
  .row.is-leader {
    background: var(--lime);
  }
  .pos,
  .pts {
    font-family: var(--font-display);
    font-size: var(--fs-36);
    line-height: 1;
  }
  .pts {
    text-align: right;
  }
  .name {
    overflow: hidden;
    font-weight: 600;
    font-size: var(--fs-16);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- Larger screens ---------- */
  @media (min-width: 30em) {
    .title {
      font-size: var(--fs-72);
    }
  }

  @media (min-width: 48em) {
    .hero {
      padding-top: var(--s-7);
    }
    .title {
      font-size: var(--fs-96);
    }
    .hero--A .demo-area {
      grid-column: content-start / full-end;
      padding: var(--s-7) var(--s-7) var(--s-8);
    }
  }

  @media (min-width: 64em) {
    .hero {
      padding-top: var(--s-8);
    }
    .title {
      margin-bottom: var(--s-7);
    }
    .intro {
      grid-column: 2 / span 4;
      grid-row: 2;
      margin-top: 0;
    }
    .demo-area {
      grid-row: 2;
      margin-top: 0;
    }
    .hero--A .demo-area {
      grid-column: 6 / full-end;
    }
    .hero--B .demo-area {
      grid-column: 6 / content-end;
    }
  }

  @media (min-width: 75em) {
    .title {
      font-size: var(--fs-hero-128);
    }
  }

  /* Short laptop windows: step the headline down one size so the button stays in view. */
  @media (min-width: 64em) and (max-height: 760px) {
    .hero {
      padding-top: var(--s-5);
    }
    .title {
      font-size: var(--fs-96);
      margin-bottom: var(--s-6);
    }
  }
</style>
