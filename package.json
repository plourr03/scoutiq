{
  "name": "scout-iq-site",
  "private": true,
  "type": "module",
  "description": "Static site for scout-iq.com, built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "emulators": "firebase emulators:start --project demo-scoutiq",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-scoutiq \"node --test tests/rules/\"",
    "test:unit": "node --test tests/unit/",
    "test:hosting": "node --test tests/hosting/",
    "test:import": "firebase emulators:exec --only firestore,storage,auth --project demo-scoutiq \"node --test tests/import/\"",
    "seed:sample": "node scripts/emulator/seed.mjs",
    "import:client": "node scripts/import-client.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "clients:local": "astro build && firebase emulators:exec --project demo-scoutiq --ui \"node scripts/emulator/seed.mjs --stay\""
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "astro": "7.4.4",
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1"
  }
}
