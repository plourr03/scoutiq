---
// Hero: the words on Chalk, then the demo on a Lime field that bleeds off the right
// and bottom edges (full width on a phone).
import home from '../copy/home.json';
import settings from '../settings.json';
import Demo from './Demo.astro';

const copy = home.hero;
const mailto = `mailto:${settings.contactEmail}?subject=${encodeURIComponent(settings.contactSubject)}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid page-grid">
    <h1 id="hero-title" class="title">
      {copy.headline.map((line, i) => <Fragment>{i > 0 && ' '}<span class="line">{line}</span></Fragment>)}
    </h1>

    <div class="intro">
      <p class="lede">{copy.supporting}</p>
      <div class="actions">
        <a class="btn btn--primary btn--large" href={mailto}>{copy.button}</a>
        <a class="text-link" href={copy.link.href}>{copy.link.label}</a>
      </div>
    </div>

    <div class="field">
      <Demo />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--chalk);
    padding-top: var(--s-6);
  }

  /* ---------- Words ---------- */
  /* 72 px on phones: the short headline fills about three quarters of the line at 390 px
     and still fits at 320 px. 96 px from tablet, 128 px from 1200 px. */
  .title {
    font-size: var(--fs-72);
    line-height: var(--lh-display);
  }
  .title .line {
    display: block;
  }
  .intro {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
    align-content: start;
  }
  .lede {
    max-width: 32ch;
    font-size: var(--fs-21);
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  /* ---------- Lime field ---------- */
  .field {
    grid-column: full;
    margin-top: var(--s-7);
    padding: var(--s-6) var(--gutter) var(--s-7);
    background: var(--lime);
  }

  @media (min-width: 48em) {
    .hero {
      padding-top: var(--s-7);
    }
    .title {
      font-size: var(--fs-96);
    }
    .field {
      grid-column: content-start / full-end;
      padding: var(--s-7) var(--s-7) var(--s-8);
    }
  }

  @media (min-width: 64em) {
    .hero {
      padding-top: var(--s-8);
    }
    .title {
      margin-bottom: var(--s-7);
    }
    .intro {
      grid-column: 2 / span 4;
      grid-row: 2;
      margin-top: 0;
    }
    .field {
      grid-column: 6 / full-end;
      grid-row: 2;
      margin-top: 0;
    }
  }

  @media (min-width: 75em) {
    .title {
      font-size: var(--fs-hero-128);
    }
  }

  /* Short laptop windows: step the headline down one size so the button stays in view. */
  @media (min-width: 64em) and (max-height: 760px) {
    .hero {
      padding-top: var(--s-5);
    }
    .title {
      font-size: var(--fs-96);
      margin-bottom: var(--s-6);
    }
  }
</style>
