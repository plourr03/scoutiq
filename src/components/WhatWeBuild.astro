---
// What we build: seven rows laid out like a sheet. The thing on the left, one plain sentence on the right.
import home from '../copy/home.json';
const copy = home.whatWeBuild;
---

<section id="what-we-build" class="section ground-cell" aria-labelledby="what-we-build-title">
  <div class="page-grid">
    <div class="head">
      <h2 id="what-we-build-title">{copy.heading}</h2>
      <p class="intro">{copy.intro}</p>
    </div>
    <dl class="build">
      {
        copy.rows.map((row) => (
          <div class="build-row">
            <dt>{row.thing}</dt>
            <dd>{row.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  h2 {
    font-size: var(--fs-48);
  }
  .head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-7);
  }
  .intro {
    max-width: 40ch;
    font-size: var(--fs-21);
    line-height: 1.45;
  }

  /* The sheet: square corners, Line grid lines, Chalk cells on the Cell ground. */
  .build {
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    background: var(--chalk);
  }
  .build-row {
    padding: var(--s-4) var(--s-4) var(--s-5);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  dt {
    margin-bottom: var(--s-1);
    font-size: var(--fs-18);
    font-weight: 700;
    line-height: 1.35;
  }
  dd {
    max-width: var(--measure);
  }

  @media (min-width: 48em) {
    h2 {
      font-size: var(--fs-72);
    }
    .build {
      display: grid;
      grid-template-columns: subgrid;
    }
    .build-row {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      padding: 0;
      border-right: 0;
      border-bottom: 0;
    }
    dt,
    dd {
      padding: var(--s-5) var(--s-4);
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    dt {
      grid-column: 1 / span 4;
      /* Reach across the column gap so the grid line sits on the start of column 5. */
      margin-right: calc(var(--gap) * -1);
      margin-bottom: 0;
      font-size: var(--fs-21);
      line-height: 1.3;
    }
    dd {
      grid-column: 5 / -1;
    }
  }

  @media (min-width: 64em) {
    .head {
      grid-column: 2 / span 7;
    }
  }
</style>
