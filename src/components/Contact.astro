---
// Contact: a full width Lime band. Only Charcoal type on Lime.
// The address is plain text a person can select; with JavaScript a small button copies it.
import home from '../copy/home.json';
import settings from '../settings.json';
const copy = home.contact;
const mailto = `mailto:${settings.contactEmail}?subject=${encodeURIComponent(settings.contactSubject)}`;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="page-grid">
    <div class="inner">
      <h2 id="contact-title">{copy.heading}</h2>
      <p class="sentence">{copy.sentence}</p>
      <div class="actions">
        <a class="btn btn--primary btn--large" href={mailto}>{copy.button}</a>
        <div class="address-row">
          <p class="address" data-address>{settings.contactEmail}</p>
          <button type="button" class="btn btn--secondary copy" data-copy data-copied-label={copy.copiedButton}>
            {copy.copyButton}
          </button>
        </div>
      </div>
      <p class="vh" aria-live="polite" data-copy-status></p>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const address = document.querySelector<HTMLElement>('[data-address]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (button && address && status) {
    const label = button.textContent?.trim() ?? '';
    const copied = button.dataset.copiedLabel ?? '';
    let timer = 0;
    button.addEventListener('click', async () => {
      const value = address.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        // Older browsers: select the address and use the legacy copy command.
        const range = document.createRange();
        range.selectNodeContents(address);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        document.execCommand('copy');
        selection?.removeAllRanges();
      }
      button.textContent = copied;
      status.textContent = copied;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = label;
        status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .contact {
    padding-block: var(--section-space);
    background: var(--lime);
    color: var(--charcoal);
  }
  h2 {
    margin-bottom: var(--s-5);
    font-size: var(--fs-72);
  }
  .sentence {
    max-width: 44ch;
    margin-bottom: var(--s-6);
    font-size: var(--fs-21);
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
  }
  .address-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }
  /* Written out so it can be selected and copied by hand. */
  .address {
    font-size: var(--fs-21);
    font-weight: 600;
    overflow-wrap: anywhere;
    user-select: all;
  }
  /* The copy button only exists when the script runs. Kept a fixed width so the label swap does not shift it. */
  .copy {
    display: none;
    min-width: 8.5rem;
  }
  :global(.js) .copy {
    display: inline-flex;
  }

  @media (min-width: 48em) {
    h2 {
      font-size: var(--fs-96);
    }
  }

  @media (min-width: 64em) {
    .inner {
      grid-column: 2 / span 9;
    }
  }
</style>
