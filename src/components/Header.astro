---
// Site header. Desktop: horizontal logo, three links, Email us button.
// Phone: logo, Email us, and a Menu built on <details> so it works without JavaScript.
// Its label reads Close while the menu is open.
import { Picture } from 'astro:assets';
import logo from '../assets/logo/scoutiq-logo-horizontal-light.png';
import site from '../copy/site.json';
import settings from '../settings.json';

const mailto = `mailto:${settings.contactEmail}?subject=${encodeURIComponent(settings.contactSubject)}`;
const links = settings.clientSignIn.enabled
  ? [...site.nav, { label: site.clientSignIn, href: settings.clientSignIn.href }]
  : site.nav;
const logoHeight = 36;
const logoWidth = Math.round((logo.width / logo.height) * logoHeight);
---

<header id="top" class="site-header page-grid">
  <div class="bar">
    <a class="logo" href="/">
      <Picture
        src={logo}
        alt={site.logoAlt}
        width={logoWidth}
        height={logoHeight}
        densities={[1, 2, 3]}
        formats={['avif', 'webp']}
        fallbackFormat="png"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="nav-wide" aria-label="Main">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <a class="btn btn--secondary cta" href={mailto}>{site.headerButton}</a>
      <details class="menu">
        <summary>
          <span class="when-closed">{site.menuLabel}</span>
          <span class="when-open">{site.menuCloseLabel}</span>
        </summary>
        <nav class="menu-panel" aria-label="Main">
          <ul>
            {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    padding-block: var(--s-2);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }
  /* The image is 30 to 36 px tall; the link around it is a full 44 px tap target. */
  .logo {
    display: flex;
    align-items: center;
    flex: none;
    min-height: var(--tap);
    border-radius: 2px;
  }
  /* Phone: the mark 30 px tall, so the wordmark is about 16.7 px tall. */
  .logo :global(img) {
    width: auto;
    height: 1.875rem;
  }

  .nav-wide {
    display: none;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-inline-start: auto;
  }
  .cta {
    padding-inline: var(--s-3);
  }

  /* Menu: a plain text button, 44 px tall, no outline. */
  .menu summary {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-2);
    border-radius: var(--radius-button);
    font-size: var(--fs-16);
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu:not([open]) .when-open,
  .menu[open] .when-closed {
    display: none;
  }
  @media (hover: hover) {
    .menu summary:hover {
      text-decoration: underline;
    }
  }
  .menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    /* Cover the rest of the screen so nothing underneath peeks through. */
    min-height: 100dvh;
    background: var(--cell);
    padding: var(--s-4) var(--gutter) var(--s-7);
  }
  .menu-panel ul {
    list-style: none;
    padding: 0;
  }
  .menu-panel a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    color: var(--charcoal);
    font-size: var(--fs-21);
    font-weight: 600;
    text-decoration: none;
  }
  @media (hover: hover) {
    .menu-panel a:hover {
      text-decoration: underline;
    }
  }

  /* Very large text (or the narrowest phones): logo on the first row, buttons side by side on the second. */
  @media (max-width: 21em) {
    .actions {
      flex-basis: 100%;
      margin-inline-start: 0;
    }
  }

  @media (min-width: 48em) {
    .site-header {
      padding-block: var(--s-3);
    }
    /* Laptop: the mark 36 px tall, the wordmark 20 px tall. */
    .logo :global(img) {
      height: 2.25rem;
    }
    .nav-wide {
      display: block;
      margin-inline-start: auto;
    }
    .nav-wide ul {
      display: flex;
      gap: var(--s-2);
      list-style: none;
      padding: 0;
    }
    .nav-wide a {
      display: flex;
      align-items: center;
      min-height: var(--tap);
      padding-inline: var(--s-3);
      color: var(--charcoal);
      font-weight: 600;
      font-size: var(--fs-16);
      text-decoration: none;
    }
    @media (hover: hover) {
      .nav-wide a:hover {
        text-decoration: underline;
        text-decoration-thickness: 2px;
      }
    }
    .actions {
      margin-inline-start: var(--s-3);
    }
    .cta {
      padding-inline: var(--s-4);
    }
    .menu {
      display: none;
    }
  }
</style>
